rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isClassApplyOpen() {
      let config = get(/databases/$(database)/documents/settings/voteConfig).data;
      let isReservedClosed = config.reservedCloseAt is timestamp
        && config.reservedCloseAt <= request.time;
      let isReservedOpen = config.reservedOpenAt is timestamp
        && config.reservedOpenAt <= request.time;

      return !isReservedClosed && (config.isOpen == true || isReservedOpen);
    }

    function isPrivateClassOpen(classId) {
      return get(/databases/$(database)/documents/privateClasses/$(classId)).data.status == "open";
    }

    match /votes/{day} {
      allow read: if true;
      allow write: if true;
    }

    match /classVotes/{studentId} {
      allow read: if true;
      allow write: if signedIn() || isClassApplyOpen();
    }

    match /classVoteState/{day} {
      allow read: if true;
      allow write: if signedIn() || isClassApplyOpen();
    }

    match /classAttendance/{studentId} {
      allow read, write: if signedIn();
    }

    match /privateClasses/{classId} {
      allow read: if true;
      allow create, delete: if signedIn();
      allow update: if signedIn()
        || (
          isPrivateClassOpen(classId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["applicationCount", "updatedAt"])
          && request.resource.data.applicationCount == resource.data.applicationCount + 1
        );
    }

    match /privateClassApplications/{applicationId} {
      allow read: if signedIn();
      allow create: if isPrivateClassOpen(request.resource.data.classId);
      allow update, delete: if signedIn();
    }

    match /settings/{document} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /logs/{document} {
      allow read: if signedIn();
      allow write: if true;
    }
  }
}
