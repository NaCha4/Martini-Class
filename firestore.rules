rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "admin@martini.com";
    }

    function isClassDayId(dayId) {
      return dayId in ["mon", "tue", "wed", "thu", "fri"];
    }

    function isOpenClassDay(schedule, dayId) {
      return schedule.keys().hasAll(["days"])
        && schedule.days is list
        && schedule.days.size() == 5
        && (
          (schedule.days[0].id == dayId && schedule.days[0].isOpen == true)
          || (schedule.days[1].id == dayId && schedule.days[1].isOpen == true)
          || (schedule.days[2].id == dayId && schedule.days[2].isOpen == true)
          || (schedule.days[3].id == dayId && schedule.days[3].isOpen == true)
          || (schedule.days[4].id == dayId && schedule.days[4].isOpen == true)
        );
    }

    function isShortText(value, maxLength) {
      return value is string
        && value.size() > 0
        && value.size() <= maxLength;
    }

    function isText(value, maxLength) {
      return value is string
        && value.size() <= maxLength;
    }

    function isCodeHash(value) {
      return value is string
        && value.matches("^[a-f0-9]{64}$");
    }

    function isActiveMemberAccessCode(codeHash) {
      let codePath = /databases/$(database)/documents/memberAccessCodes/$(codeHash);

      return isCodeHash(codeHash)
        && exists(codePath)
        && get(codePath).data.enabled == true;
    }

    function hasActiveMemberSession() {
      return request.auth != null
        && exists(/databases/$(database)/documents/memberAccessSessions/$(request.auth.uid))
        && get(/databases/$(database)/documents/memberAccessSessions/$(request.auth.uid)).data.createdAt is timestamp
        && get(/databases/$(database)/documents/memberAccessSessions/$(request.auth.uid)).data.createdAt <= request.time
        && get(/databases/$(database)/documents/memberAccessSessions/$(request.auth.uid)).data.createdAt + duration.value(24, 'h') > request.time
        && isActiveMemberAccessCode(get(/databases/$(database)/documents/memberAccessSessions/$(request.auth.uid)).data.codeHash);
    }

    function isAdminOrMember() {
      return isAdmin() || hasActiveMemberSession();
    }

    function isValidMembershipApplication() {
      return request.resource.data.keys().hasOnly([
          "name",
          "studentId",
          "department",
          "contact",
          "email",
          "motivation",
          "note",
          "privacyAgreed",
          "status",
          "createdAt",
          "updatedAt"
        ])
        && isShortText(request.resource.data.name, 40)
        && isShortText(request.resource.data.studentId, 40)
        && isShortText(request.resource.data.department, 80)
        && isShortText(request.resource.data.contact, 40)
        && isShortText(request.resource.data.email, 120)
        && isShortText(request.resource.data.motivation, 1200)
        && isText(request.resource.data.note, 1200)
        && request.resource.data.privacyAgreed == true
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidMemberAccessSession(sessionId) {
      return request.auth != null
        && request.auth.uid == sessionId
        && request.resource.data.keys().hasOnly([
          "codeHash",
          "expiresAt",
          "createdAt",
          "updatedAt"
        ])
        && isCodeHash(request.resource.data.codeHash)
        && isActiveMemberAccessCode(request.resource.data.codeHash)
        && (
          !request.resource.data.keys().hasAny(["expiresAt"])
          || request.resource.data.expiresAt is timestamp
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isClassApplicationOpen(dayId) {
      let schedulePath = /databases/$(database)/documents/classSchedules/weekly;
      let schedule = get(schedulePath).data;
      let hasOpenAt = schedule.keys().hasAll(["reservationOpenAt"])
        && schedule.reservationOpenAt is timestamp;
      let hasCloseAt = schedule.keys().hasAll(["reservationCloseAt"])
        && schedule.reservationCloseAt is timestamp;
      let isManualOpen = schedule.keys().hasAll(["isApplicationOpen"])
        && schedule.isApplicationOpen == true;

      return isClassDayId(dayId)
        && exists(schedulePath)
        && isOpenClassDay(schedule, dayId)
        && (!hasCloseAt || schedule.reservationCloseAt > request.time)
        && (
          (hasOpenAt && schedule.reservationOpenAt <= request.time)
          || (!hasOpenAt && isManualOpen)
        );
    }

    function isValidClassApplication(applicationId) {
      return request.resource.data.keys().hasOnly([
          "dayId",
          "dayLabel",
          "name",
          "studentId",
          "createdAt",
          "updatedAt"
        ])
        && applicationId == request.resource.data.studentId
        && isClassDayId(request.resource.data.dayId)
        && isShortText(request.resource.data.dayLabel, 20)
        && isShortText(request.resource.data.name, 80)
        && isShortText(request.resource.data.studentId, 80)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && isClassApplicationOpen(request.resource.data.dayId);
    }

    function isEventRecruiting(eventId) {
      let eventPath = /databases/$(database)/documents/eventPosts/$(eventId);
      let eventData = get(eventPath).data;
      let hasRecruitOpenAt = eventData.keys().hasAll(["recruitOpenAt"])
        && eventData.recruitOpenAt is timestamp;
      let hasRecruitCloseAt = eventData.keys().hasAll(["recruitCloseAt"])
        && eventData.recruitCloseAt is timestamp;
      let hasEventAt = eventData.keys().hasAll(["eventAt"])
        && eventData.eventAt is timestamp;

      return exists(eventPath)
        && hasRecruitOpenAt
        && hasRecruitCloseAt
        && eventData.recruitOpenAt <= request.time
        && eventData.recruitCloseAt > request.time
        && (!hasEventAt || eventData.eventAt > request.time);
    }

    function isValidEventApplication(applicationId) {
      return request.resource.data.keys().hasOnly([
          "eventId",
          "eventTitle",
          "name",
          "studentId",
          "createdAt",
          "updatedAt"
        ])
        && applicationId == request.resource.data.eventId + "_" + request.resource.data.studentId
        && isShortText(request.resource.data.eventId, 120)
        && isShortText(request.resource.data.eventTitle, 120)
        && isShortText(request.resource.data.name, 80)
        && isShortText(request.resource.data.studentId, 80)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.eventTitle
          == get(/databases/$(database)/documents/eventPosts/$(request.resource.data.eventId)).data.title
        && isEventRecruiting(request.resource.data.eventId);
    }

    match /votes/{day} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /classVotes/{studentId} {
      allow read, write: if isAdmin();
    }

    match /classVoteState/{day} {
      allow read, write: if isAdmin();
    }

    match /classAttendance/{studentId} {
      allow read, write: if isAdmin();
    }

    match /inventoryItems/{itemId} {
      allow read, write: if isAdmin();
    }

    match /classSchedules/{scheduleId} {
      allow read: if isAdminOrMember();
      allow write: if isAdmin();
    }

    match /classApplications/{applicationId} {
      allow read: if isAdminOrMember();
      allow create: if hasActiveMemberSession()
        && isValidClassApplication(applicationId);
      allow update, delete: if isAdmin();
    }

    match /privateClasses/{classId} {
      allow read, write: if isAdmin();
    }

    match /privateClassApplications/{applicationId} {
      allow read, write: if isAdmin();
    }

    match /settings/voteConfig {
      allow read, write: if isAdmin();
    }

    match /membershipApplications/{applicationId} {
      allow create: if isValidMembershipApplication();
      allow read, update, delete: if isAdmin();
    }

    match /members/{memberId} {
      allow read: if isAdminOrMember();
      allow write: if isAdmin();
    }

    match /officerDepartments/{departmentId} {
      allow read, write: if isAdmin();
    }

    match /meetingMinuteTemplates/{templateId} {
      allow read, write: if isAdmin();
    }

    match /meetingMinutes/{minuteId} {
      allow read, write: if isAdmin();
    }

    match /eventPosts/{eventId} {
      allow read: if isAdminOrMember();
      allow write: if isAdmin();
    }

    match /eventApplications/{applicationId} {
      allow read: if isAdminOrMember();
      allow create: if hasActiveMemberSession()
        && isValidEventApplication(applicationId);
      allow update, delete: if isAdmin();
    }

    match /faqEntries/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /memberAccessCodes/{codeHash} {
      allow get: if isAdmin() || (
        isCodeHash(codeHash)
        && resource.data.enabled == true
      );
      allow list, create, update, delete: if isAdmin();
    }

    match /memberAccessSessions/{sessionId} {
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == sessionId);
      allow list: if isAdmin();
      allow create: if isValidMemberAccessSession(sessionId);
      allow update: if false;
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == sessionId);
    }

    match /settings/{document} {
      allow read, write: if isAdmin();
    }

    match /logs/{document} {
      allow read, write: if isAdmin();
    }
  }
}
