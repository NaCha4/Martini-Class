rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isClassApplyOpen() {
      let config = get(/databases/$(database)/documents/settings/voteConfig).data;
      let isReservedClosed = config.reservedCloseAt is timestamp
        && config.reservedCloseAt <= request.time;
      let isReservedOpen = config.reservedOpenAt is timestamp
        && config.reservedOpenAt <= request.time;

      return !isReservedClosed && (config.isOpen == true || isReservedOpen);
    }

    match /votes/{day} {
      allow read: if true;
      allow write: if true;
    }

    match /classVotes/{studentId} {
      allow read: if true;
      allow write: if signedIn() || isClassApplyOpen();
    }

    match /classVoteState/{day} {
      allow read: if true;
      allow write: if signedIn() || isClassApplyOpen();
    }

    match /settings/{document} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /logs/{document} {
      allow read: if signedIn();
      allow write: if true;
    }
  }
}
