rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "admin@martini.com";
    }

    function isWeekday(day) {
      return day in ["monday", "tuesday", "wednesday", "thursday", "friday"];
    }

    function isShortText(value, maxLength) {
      return value is string
        && value.size() > 0
        && value.size() <= maxLength;
    }

    function isText(value, maxLength) {
      return value is string
        && value.size() <= maxLength;
    }

    function isCodeHash(value) {
      return value is string
        && value.matches("^[a-f0-9]{64}$");
    }

    function isActiveMemberAccessCode(codeHash) {
      let codePath = /databases/$(database)/documents/memberAccessCodes/$(codeHash);

      return isCodeHash(codeHash)
        && exists(codePath)
        && get(codePath).data.enabled == true;
    }

    function hasActiveMemberSession() {
      return request.auth != null
        && exists(/databases/$(database)/documents/memberAccessSessions/$(request.auth.uid))
        && get(/databases/$(database)/documents/memberAccessSessions/$(request.auth.uid)).data.expiresAt is timestamp
        && get(/databases/$(database)/documents/memberAccessSessions/$(request.auth.uid)).data.expiresAt > request.time
        && isActiveMemberAccessCode(get(/databases/$(database)/documents/memberAccessSessions/$(request.auth.uid)).data.codeHash);
    }

    function isAdminOrMember() {
      return isAdmin() || hasActiveMemberSession();
    }

    function isClassApplyOpen() {
      let config = get(/databases/$(database)/documents/settings/voteConfig).data;
      let isReservedClosed = config.reservedCloseAt is timestamp
        && config.reservedCloseAt <= request.time;
      let isReservedOpen = config.reservedOpenAt is timestamp
        && config.reservedOpenAt <= request.time;

      return !isReservedClosed && (config.isOpen == true || isReservedOpen);
    }

    function classVoteStateCount(day) {
      let statePath = /databases/$(database)/documents/classVoteState/$(day);
      return exists(statePath) && get(statePath).data.count is int
        ? get(statePath).data.count
        : 0;
    }

    function isClassVoteStateIncremented(day) {
      let statePath = /databases/$(database)/documents/classVoteState/$(day);
      let afterState = getAfter(statePath).data;

      return afterState.count is int
        && afterState.count == classVoteStateCount(day) + 1
        && afterState.count <= 500;
    }

    function isValidClassVote(studentId) {
      return request.resource.data.keys().hasOnly([
          "name",
          "studentId",
          "day",
          "dayLabel",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.studentId == studentId
        && isShortText(request.resource.data.name, 40)
        && isShortText(request.resource.data.studentId, 40)
        && isWeekday(request.resource.data.day)
        && isShortText(request.resource.data.dayLabel, 20)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && isClassVoteStateIncremented(request.resource.data.day);
    }

    function isValidClassVoteStateBase(day) {
      return isWeekday(day)
        && request.resource.data.keys().hasOnly(["count"])
        && request.resource.data.count is int
        && request.resource.data.count > 0
        && request.resource.data.count <= 500;
    }

    function isValidClassVoteStateCreate(day) {
      return isValidClassVoteStateBase(day)
        && request.resource.data.count == 1;
    }

    function isValidClassVoteStateUpdate(day) {
      let previousCount = resource.data.count is int
        ? resource.data.count
        : 0;

      return isValidClassVoteStateBase(day)
        && request.resource.data.count == previousCount + 1;
    }

    function isPrivateClassOpen(classId) {
      let classData = get(/databases/$(database)/documents/privateClasses/$(classId)).data;
      let hasRecruitSchedule = classData.recruitOpenAt is timestamp
        && classData.recruitCloseAt is timestamp;
      let applicationCount = classData.applicationCount is int
        ? classData.applicationCount
        : 0;
      let isScheduledOpen = hasRecruitSchedule
        && classData.recruitOpenAt <= request.time
        && classData.recruitCloseAt > request.time;
      let isNotFull = !(classData.capacity is int)
        || classData.capacity <= 0
        || applicationCount < classData.capacity;

      return isNotFull
        && (
          (hasRecruitSchedule && isScheduledOpen)
          || (!hasRecruitSchedule && classData.status == "open")
        );
    }

    function isPrivateClassApplicationCountIncremented(classId) {
      let classPath = /databases/$(database)/documents/privateClasses/$(classId);
      let previousCount = get(classPath).data.applicationCount is int
        ? get(classPath).data.applicationCount
        : 0;
      let afterClass = getAfter(classPath).data;

      return afterClass.applicationCount is int
        && afterClass.applicationCount == previousCount + 1
        && afterClass.updatedAt is timestamp;
    }

    function isValidPrivateClassApplication(applicationId) {
      return request.resource.data.keys().hasOnly([
          "classId",
          "classTitle",
          "name",
          "studentId",
          "createdAt"
        ])
        && applicationId == request.resource.data.classId + "_" + request.resource.data.studentId
        && isShortText(request.resource.data.classId, 120)
        && isShortText(request.resource.data.classTitle, 120)
        && isShortText(request.resource.data.name, 80)
        && isShortText(request.resource.data.studentId, 80)
        && request.resource.data.createdAt is timestamp
        && isPrivateClassOpen(request.resource.data.classId)
        && isPrivateClassApplicationCountIncremented(request.resource.data.classId);
    }

    function isValidPrivateClassApplyCountUpdate(classId) {
      let previousCount = resource.data.applicationCount is int
        ? resource.data.applicationCount
        : 0;

      return isPrivateClassOpen(classId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["applicationCount", "updatedAt"])
        && request.resource.data.applicationCount is int
        && request.resource.data.applicationCount == previousCount + 1
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidMembershipApplication() {
      return request.resource.data.keys().hasOnly([
          "name",
          "studentId",
          "department",
          "contact",
          "email",
          "motivation",
          "note",
          "privacyAgreed",
          "status",
          "createdAt",
          "updatedAt"
        ])
        && isShortText(request.resource.data.name, 40)
        && isShortText(request.resource.data.studentId, 40)
        && isShortText(request.resource.data.department, 80)
        && isShortText(request.resource.data.contact, 40)
        && isShortText(request.resource.data.email, 120)
        && isShortText(request.resource.data.motivation, 1200)
        && isText(request.resource.data.note, 1200)
        && request.resource.data.privacyAgreed == true
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidMemberAccessSession(sessionId) {
      return request.auth != null
        && request.auth.uid == sessionId
        && request.resource.data.keys().hasOnly([
          "codeHash",
          "expiresAt",
          "createdAt",
          "updatedAt"
        ])
        && isCodeHash(request.resource.data.codeHash)
        && isActiveMemberAccessCode(request.resource.data.codeHash)
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /votes/{day} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /classVotes/{studentId} {
      allow read: if isAdminOrMember();
      allow create: if isAdmin()
        || (hasActiveMemberSession() && isClassApplyOpen() && isValidClassVote(studentId));
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /classVoteState/{day} {
      allow read: if isAdminOrMember();
      allow create: if isAdmin()
        || (hasActiveMemberSession() && isClassApplyOpen() && isValidClassVoteStateCreate(day));
      allow update: if isAdmin()
        || (hasActiveMemberSession() && isClassApplyOpen() && isValidClassVoteStateUpdate(day));
      allow delete: if isAdmin();
    }

    match /classAttendance/{studentId} {
      allow read, write: if isAdmin();
    }

    match /inventoryItems/{itemId} {
      allow read, write: if isAdmin();
    }

    match /classSchedules/{scheduleId} {
      allow read: if isAdminOrMember();
      allow write: if isAdminOrMember();
    }

    match /privateClasses/{classId} {
      allow read: if isAdminOrMember();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (hasActiveMemberSession() && isValidPrivateClassApplyCountUpdate(classId));
    }

    match /privateClassApplications/{applicationId} {
      allow read: if isAdmin();
      allow create: if hasActiveMemberSession()
        && isValidPrivateClassApplication(applicationId);
      allow update, delete: if isAdmin();
    }

    match /settings/voteConfig {
      allow read: if isAdminOrMember();
      allow write: if isAdmin();
    }

    match /membershipApplications/{applicationId} {
      allow create: if isValidMembershipApplication();
      allow read, update, delete: if isAdmin();
    }

    match /members/{memberId} {
      allow read: if isAdminOrMember();
      allow write: if isAdmin();
    }

    match /officerDepartments/{departmentId} {
      allow read, write: if isAdmin();
    }

    match /meetingMinuteTemplates/{templateId} {
      allow read, write: if isAdmin();
    }

    match /meetingMinutes/{minuteId} {
      allow read, write: if isAdmin();
    }

    match /eventPosts/{eventId} {
      allow read: if isAdminOrMember();
      allow write: if isAdminOrMember();
    }

    match /faqEntries/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /memberAccessCodes/{codeHash} {
      allow get: if isAdmin() || (
        isCodeHash(codeHash)
        && resource.data.enabled == true
      );
      allow list, create, update, delete: if isAdmin();
    }

    match /memberAccessSessions/{sessionId} {
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == sessionId);
      allow list: if isAdmin();
      allow create, update: if isValidMemberAccessSession(sessionId);
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == sessionId);
    }

    match /settings/{document} {
      allow read, write: if isAdmin();
    }

    match /logs/{document} {
      allow read, write: if isAdmin();
    }
  }
}
