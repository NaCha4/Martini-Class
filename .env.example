# Local-only examples. Do not put real secret values in this file.

# Optional path used by local maintenance scripts that need Firebase Admin SDK.
# Keep the real JSON file under .secrets/ and never commit it.
GOOGLE_APPLICATION_CREDENTIALS=.secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=martini-class-d4d69

# Public Firebase Web/App Check values are intentionally kept in the client app.
